apiVersion: v1
kind: Secret
metadata:
  name: aws-file-credentials
type: Opaque
stringData:
  credentials: |
    [default]
    aws_access_key_id = access_key
    aws_secret_access_key = secret_key

---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: troubleshoot
  namespace: alpha
  labels:
    app: troubleshoot
spec:
  replicas: 1
  selector:
    matchLabels:
      app: troubleshoot
  template:
    metadata:
      labels:
        app: troubleshoot
    spec:
      containers:
      - name: troubleshoot
        image: vijikalavarkar/troubleshootingtools:v1
        imagePullPolicy: Always
        volumeMounts:
        - name: secret-volume
          mountPath: /root/.aws
          readOnly: true
      volumes:
      - name: secret-volume
        secret:
          secretName: aws-file-credentials
